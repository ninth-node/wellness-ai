# ==============================================================================
# AI-First Wellness & Beauty Management Platform
# Environment Variables Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ==============================================================================

# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=development
APP_NAME="Wellness AI Platform"
APP_VERSION=0.1.0
DEBUG=true

# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL Connection
DATABASE_URL=postgresql://wellness_user:wellness_dev_password@localhost:5432/wellness_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# For production, use separate components:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=wellness_ai
# DB_USER=wellness_user
# DB_PASSWORD=your_secure_password_here

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_URL=redis://:redis_dev_password@localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=50

# ==============================================================================
# API Configuration
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_BASE_URL=http://localhost:8000

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate secure secret: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# ==============================================================================
# AI & Machine Learning Configuration
# ==============================================================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# LangSmith (for monitoring)
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=wellness-ai-dev

# Vector Database
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
WEAVIATE_URL=http://localhost:8080

# ==============================================================================
# Cloud Storage (AWS S3 or compatible)
# ==============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=wellness-ai-uploads
AWS_S3_ENDPOINT_URL=http://localhost:9000  # For MinIO local dev

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf

# ==============================================================================
# Payment Processing
# ==============================================================================
# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
STRIPE_API_VERSION=2023-10-16

# ==============================================================================
# Communication Services
# ==============================================================================
# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@wellness-ai.com
SENDGRID_FROM_NAME="Wellness AI Platform"

# For development, use MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# ==============================================================================
# Monitoring & Logging
# ==============================================================================
# Sentry
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================================================
# Celery Configuration
# ==============================================================================
CELERY_BROKER_URL=redis://:redis_dev_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_dev_password@localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300

# ==============================================================================
# External API Integrations
# ==============================================================================
# Skin Analysis Equipment APIs
VISIA_API_KEY=your-visia-api-key-here
VISIA_API_URL=https://api.visia.example.com
OBSERV_API_KEY=your-observ-api-key-here

# Beauty Commerce Partners
SEPHORA_API_KEY=your-sephora-api-key-here
LOREAL_API_KEY=your-loreal-api-key-here

# Wearable Device APIs
FITBIT_CLIENT_ID=your-fitbit-client-id
FITBIT_CLIENT_SECRET=your-fitbit-client-secret
OURA_ACCESS_TOKEN=your-oura-access-token

# Weather API (for skin analysis)
WEATHER_API_KEY=your-weather-api-key-here

# ==============================================================================
# Feature Flags
# ==============================================================================
ENABLE_AI_SKIN_ANALYSIS=true
ENABLE_AR_TRY_ON=false
ENABLE_WEARABLE_INTEGRATION=false
ENABLE_SUBSCRIPTION_BOXES=true
ENABLE_DYNAMIC_PRICING=false

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==============================================================================
# Development Tools
# ==============================================================================
# Enable development tools
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true
ENABLE_DEBUG_TOOLBAR=true

# ==============================================================================
# Testing
# ==============================================================================
TEST_DATABASE_URL=postgresql://wellness_user:wellness_dev_password@localhost:5432/wellness_ai_test
TEST_REDIS_URL=redis://:redis_dev_password@localhost:6379/15

# ==============================================================================
# Notes:
# ==============================================================================
# 1. Copy this file to .env for local development
# 2. Generate secure secrets using: openssl rand -hex 32
# 3. Never commit .env or any file containing real credentials
# 4. Use environment-specific files (.env.development, .env.production)
# 5. In production, use proper secret management (AWS Secrets Manager, etc.)
# 6. Validate all environment variables on application startup
# ==============================================================================
